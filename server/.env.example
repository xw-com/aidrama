# ===== 服务 =====
PORT=3000

#production or development
NODE_ENV=production
# CORS 允许的前端地址（多个用逗号分隔）；同时作为 /api/oauth 代理的 redirect_uri 源白名单
# （miniclient 本地开发跑 5174 端口，联调 OAuth 登录时须把 http://localhost:5174 也加进来）
CLIENT_ORIGIN=http://localhost:5173

# ===== 鉴权 =====
# JWT 直连密钥：与 xworld 账号服务（auth.example.com）共享同一密钥（HS256），仅用于本地验签
# xworld 直连模式签发的平台 JWT（uniapp 等纯直连端）。按令牌内用户 id 懒同步本地 User。
# 注意与下方 XWORLD_OAUTH2_CLIENT_SECRET 完全独立、互不替代。部署时请填写真实密钥。
JWT_SECRET=
# 仅用于本系统仍需自签令牌的残留场景（登录令牌已由 xworld 签发）
JWT_EXPIRES_IN=7d

# ===== 管理后台（独立登录入口 /admin）=====
# 管理台专用 JWT 密钥（admt_ 前缀管理令牌）：管理台经 /admin 登录页（账号密码+验证码）换取。
# 留空回退 JWT_SECRET（本地开发零配置）；生产建议配独立随机长钥，避免与用户令牌伪造风险互相放大
ADMIN_JWT_SECRET=
# 管理令牌有效期（默认 12h；到期需重新登录，无刷新机制）
# ADMIN_TOKEN_TTL=12h

# ===== xworld OAuth2 授权服务器（统一账号中心）=====
# 客户端登录走授权码流程后 access_token 为 xwat_ 不透明令牌，本服务端回源该地址校验
XWORLD_API_BASE=https://auth.example.com/api/v1
# userinfo 校验结果的内存缓存时长（毫秒）
# XWORLD_VERIFY_CACHE_TTL_MS=300000

# ===== xworld OAuth2 客户端凭据（机密客户端，服务端代理令牌交换）=====
# 本系统在 xworld 授权服务器登记的 OAuth2 客户端身份，与上面的 JWT_SECRET 完全独立：
# Web 端（client/miniclient）换码/刷新/吊销令牌改走本系统 /api/oauth/* 代理，
# client_secret 只存在于此服务端并在此附加，绝不下发前端；浏览器只提交授权码 + PKCE verifier。
# 须与前端 VITE_OAUTH_CLIENT_ID（授权跳转用）指向同一 client。
# clientSecret 留空=公开客户端直通（仅 PKCE，本地开发零影响）；clientId 留空回退前端传入。
XWORLD_OAUTH2_CLIENT_ID=
XWORLD_OAUTH2_CLIENT_SECRET=

# ===== 点选文字验证码（可选，均有默认值）=====
# 验证通过后签发的 ticket（captcha_ticket）密钥；留空复用 JWT_SECRET，xworld 侧将来可直接验签
CAPTCHA_TICKET_SECRET=
# 题目有效期（毫秒）/ 单题最多提交次数 / 点击容差（viewBox px）/ 内存题目上限
# CAPTCHA_TTL_MS=120000
# CAPTCHA_MAX_ATTEMPTS=5
# CAPTCHA_TOLERANCE=30
# CAPTCHA_MAX_STORE=5000

# ===== 数据库 =====
# DB_DIALECT: mysql | sqlite   （sqlite 时只需 DB_STORAGE）
DB_DIALECT=sqlite
DB_STORAGE=./data/aidrama.db
# 仅 mysql 模式使用：
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aidrama
DB_USER=root
DB_PASSWORD=
# SQL 日志(调试用,置 1 打印全部 SQL 语句)
DB_SQL_LOG=0

# ===== 媒体与文件 =====
# 上传/生成文件的输出目录
UPLOAD_DIR=./data/uploads
# 合成视频输出目录
OUTPUT_DIR=./data/outputs
# ffmpeg 可执行路径（默认从 PATH 查找）
FFMPEG_PATH=
# 通过公网访问服务端文件的基础地址（用于返回给前端的 url）
PUBLIC_BASE_URL=http://localhost:3000
# /files 视频/音频防盗链：nginx secure_link 时效签名密钥（与 deploy/nginx.conf 的
# secure_link_md5 一致），出口 URL 自动追加 ?expires=&sign=；图片不受影响。
# 留空=不签名（本地开发零影响）。nginx 上线校验块前必须先配置，否则媒体链接全 403
FILE_SIGN_SECRET=
# 静态图片版本号：追加到风格缩略图 URL 尾部（如 preview.png?1）破浏览器缓存，更新图片后 +1
STATIC_IMAGE_VERSION=1

# ===== 默认模型配置（seed 时写入，留空则不写） =====
# 文本大模型（OpenAI 兼容）
DEFAULT_TEXT_BASE_URL=https://api.openai.com/v1
DEFAULT_TEXT_API_KEY=
DEFAULT_TEXT_MODEL=gpt-4o-mini
# 图像生成
DEFAULT_IMAGE_BASE_URL=https://api.openai.com/v1
DEFAULT_IMAGE_API_KEY=
DEFAULT_IMAGE_MODEL=dall-e-3
# 视频生成（可留空，留空则走 local-ffmpeg 兜底）
DEFAULT_VIDEO_BASE_URL=
DEFAULT_VIDEO_API_KEY=
DEFAULT_VIDEO_MODEL=
# TTS（可留空）
DEFAULT_TTS_BASE_URL=
DEFAULT_TTS_API_KEY=
DEFAULT_TTS_MODEL=

# ===== 微信（全部可选，留空=未启用）=====
# --- 登录（开放平台网页扫码 qrconnect）---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 前端回调页地址（需在微信公众平台「授权回调域」中登记该域名）
WECHAT_LOGIN_REDIRECT_URI=http://localhost:5173/login/wechat/callback

# --- 小程序（weapp 壳：登录 code2Session + 积分充值拉起支付）---
# weapp 壳小程序 wx.login 的 code 在此换 openid 建号签票；secret 为小程序自己的 AppSecret
# AppID 留空回退 WECHAT_APP_ID；微信登录功能是否可用以 WECHAT_MINI_APP_SECRET 是否配置为准
# 小程序内充值：web-view 禁止 JSAPI 拉起支付，H5 跳壳支付页用本 AppID 下单 + wx.requestPayment，
# 须在微信商户平台把该小程序 AppID 与商户号（WECHAT_PAY_MCH_ID）绑定
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# --- 支付（微信支付 V3 · Native 扫码 / JSAPI 公众号内支付）---
# 支付方式切换：native=扫码（PC 出微信原生二维码）| jsapi=公众号内拉起支付（PC 出 H5 收银台二维码）
WECHAT_PAY_METHOD=native
# JSAPI 网页授权换 openid 所用公众号 Secret；留空回退 WECHAT_APP_SECRET（须与支付 AppID 同主体）
#WECHAT_PAY_APP_SECRET=
# H5 收银台页地址（jsapi 模式下 PC 端二维码指向）；留空取 ${PUBLIC_BASE_URL}/pay.html
#WECHAT_PAY_JSAPI_CASHIER_URL=
# 与商户号绑定的 AppID；留空则回退使用上面的 WECHAT_APP_ID
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
# APIv3 密钥（32 位）
WECHAT_PAY_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥（apiclient_key.pem）：路径优先，其次内联 PEM（二选一）
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
# 支付结果异步回调地址；留空取 ${PUBLIC_BASE_URL}/api/recharge/wechat/notify
WECHAT_PAY_NOTIFY_URL=

# ===== App 端第三方一键登录（iOS Sign in with Apple / Android Google，留空=未启用）=====
# 客户端 uni.login 取凭证 → 服务端 /api/auth/oauth/apple|google 验签建号。
# 申请与配置步骤见 docs/Apple登录申请与部署.md、docs/Google登录申请与部署.md
# iOS App 的 Bundle ID（须与 HBuilderX 打包面板、Apple Developer Identifiers 三处逐字一致）
APPLE_BUNDLE_ID=com.example.aidrama
# 允许的 Google OAuth 客户端 ID（逗号分隔；Android 客户端必配，加 iOS/Web 时追加）
GOOGLE_CLIENT_IDS=
# 以下一般无需改动：厂商 JWKS / userinfo 端点与 JWKS 缓存时长（联调可用本地假 JWKS 覆盖）
APPLE_JWKS_URL=
GOOGLE_JWKS_URL=
GOOGLE_USERINFO_URL=
OAUTH_JWKS_CACHE_TTL_MS=
# 第三方登录会话时长：access 短、refresh 长（refresh 不轮换）
APP_TOKEN_TTL=7d
APP_REFRESH_TTL=30d

# —— 上线合规与防护（2026-09 整改新增）——
# AIGC 显式标识总开关：成片视频/AI 封面自动加「AI生成」角标+视频元数据；'0'/'false' 关闭（合规不建议）
#AIGC_LABEL=1
# AI 生成入口每用户每分钟提交上限（createJob 类 POST；admin 豁免）
#AI_RATE_LIMIT_PER_MIN=30
# 微信支付平台证书定时刷新间隔（小时，1-168）
#WECHAT_PAY_CERT_REFRESH_HOURS=12
# 回调 serial 未命中时强制刷新平台证书的最小间隔（秒，防伪造 serial 打爆接口；0=不限）
#WECHAT_PAY_CERT_FORCE_REFRESH_MIN_SEC=10
# 回调时间戳允许偏差秒数（防重放；0=关闭，仅联调）
#WECHAT_PAY_VERIFY_MAX_SKEW_SEC=300
# =1 时平台证书不可用即拒绝回调（fail-closed）；默认降级为仅 AES-GCM 解密兜底，保可用性
#WECHAT_PAY_VERIFY_STRICT=
