# 前端环境变量（开发时通过 vite proxy 转发到服务端 3000）
# 生产部署时改为服务端实际地址
VITE_API_BASE=/api

# xworld 账号服务（OAuth2 授权中心：托管登录/注册页、令牌端点、userinfo）—— 前端直连，不走 /api 代理
VITE_XWORLD_API_BASE=https://auth.example.com/api/v1

# xworld OAuth2 授权服务器上登记的客户端 ID（公开客户端 + PKCE，无密钥）
# 须在 xworld 管理后台登记本站回调地址：<站点地址>/oauth/callback（逐字节一致）
VITE_OAUTH_CLIENT_ID=xw_your_client_id

# ===== 合规 / SEO =====
# ICP 备案号：展示中心与登录页页脚显示；注释/留空则页脚不显示备案段（上线前替换为实际备案号）
# VITE_ICP_NO=京ICP备0000000000号-1
# 站点描述：index.html 的 meta description / og:description 通过 %VITE_SITE_DESCRIPTION% 注入
VITE_SITE_DESCRIPTION=星网 AI 短剧工坊：用 AI 完成从剧本到成片的短剧创作，支持剧本、分镜、图像、配音与视频合成。
