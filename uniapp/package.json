{
  "name": "aidrama-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "XWorld 掌上制片厂 · uniapp 全端版（H5 / 微信小程序 / App[Android/iOS/鸿蒙]）",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "dev:app-android": "uni -p app-android",
    "build:app-android": "uni build -p app-android",
    "dev:app-ios": "uni -p app-ios",
    "build:app-ios": "uni build -p app-ios",
    "dev:app-harmony": "uni -p app-harmony",
    "build:app-harmony": "uni build -p app-harmony",
    "rmiosres": "rm -rf dist/build/app app/IOS/XWorldAIDrama/XWorld-AIDrama/Pandora/apps/__UNI__000B765/www",
    "copytoxcode": "cp -Rf dist/build/app app/IOS/XWorldAIDrama/XWorld-AIDrama/Pandora/apps/__UNI__000B765/www",
    "iosrelease": "npm run rmiosres && npm run build:app-ios && npm run copytoxcode"
  },
